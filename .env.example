KERBL_EMAIL=your-email@example.com
KERBL_PASSWORD=your-password
KERBL_BASE_URL=https://backend.kerbl-iot.com

# JSON array; the name must match the Kerbl device description exactly.
KERBL_DEVICES=[{"type":"smart-coop","name":"Hühnerstall"}]

MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_TOPIC_PREFIX=kerbl
POLL_INTERVAL_SECONDS=900
